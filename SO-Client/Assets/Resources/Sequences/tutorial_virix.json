{
  "schemaVersion": 1,
  "sequenceId": "tutorial_virix",
  "missionId": "tutorial_curriculum",
  "description": "Virix — spores, flowers, production on BISMUTH.",
  "steps": [
    {
      "id": "lock",
      "type": "setInputLock",
      "locked": true,
      "reason": "tutorial_virix"
    },
    {
      "id": "dlg_welcome",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Welcome to the <b>Virix</b> tutorial. The hive thrives where <b>BISMUTH</b> burns hottest.",
      "waitForContinue": true
    },
    {
      "id": "dlg_spore",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "The <b>Spore</b> captures sites. It is fragile and cannot attack, but flies over terrain.",
      "waitForContinue": true
    },
    {
      "id": "camera_spore",
      "type": "cameraFocus",
      "target": { "unitId": "p1_spore" },
      "durationMs": 400
    },
    {
      "id": "guide_spore",
      "type": "guideClick",
      "target": { "unitId": "p1_spore" }
    },
    {
      "id": "guide_capture",
      "type": "guideClick",
      "target": { "uiTarget": "captureButton" }
    },
    {
      "id": "dlg_seed",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "When a Spore captures a site it becomes a <b>seed</b> that blooms into a flower next turn.",
      "waitForContinue": true
    },
    {
      "id": "end_p1_bloom_turn",
      "type": "endPlayerTurn",
      "player": 1,
      "waitForClick": true,
      "endTurnUiTarget": "endTurnButton"
    },
    {
      "id": "end_p2_bloom_turn",
      "type": "endPlayerTurn",
      "player": 2
    },
    {
      "id": "dlg_flower_spore",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "The flower pollenates the tile and spawns a free Spore each turn.",
      "waitForContinue": true
    },
    {
      "id": "dlg_produce_on_bismuth",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Stronger Virix units are built <b>on</b> captured BISMUTH. Select your owned node.",
      "waitForContinue": true
    },
    {
      "id": "guide_bismuth",
      "type": "guideClick",
      "target": { "structureId": "owned_bismuth" }
    },
    {
      "id": "end_p1_cycle_turn",
      "type": "endPlayerTurn",
      "player": 1,
      "waitForClick": true,
      "endTurnUiTarget": "endTurnButton"
    },
    {
      "id": "end_p2_cycle_turn",
      "type": "endPlayerTurn",
      "player": 2
    },
    {
      "id": "dlg_produce_again",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Produce again from the same node when you are ready.",
      "waitForContinue": true
    },
    {
      "id": "dlg_done",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Well done — you understand Virix growth and production.",
      "waitForContinue": true
    },
    {
      "id": "complete",
      "type": "showTutorialComplete"
    },
    {
      "id": "unlock",
      "type": "setInputLock",
      "locked": false
    }
  ]
}
