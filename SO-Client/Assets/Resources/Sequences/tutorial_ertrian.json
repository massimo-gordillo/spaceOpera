{
  "schemaVersion": 1,
  "sequenceId": "tutorial_ertrian",
  "missionId": "tutorial_curriculum",
  "description": "Ertrian — income bonus, factories, airports, ranged fire.",
  "steps": [
    {
      "id": "lock",
      "type": "setInputLock",
      "locked": true,
      "reason": "tutorial_ertrian"
    },
    {
      "id": "dlg_welcome",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Welcome to the <b>Ertrian</b> tutorial. Here you will learn production and ranged warfare.",
      "waitForContinue": true
    },
    {
      "id": "dlg_income",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Ertrians earn a <b>10% bonus</b> on structure income — control more BISMUTH to out-spend your foe.",
      "waitForContinue": true
    },
    {
      "id": "camera_structures",
      "type": "cameraMove",
      "target": { "structureId": "factory" },
      "durationMs": 500
    },
    {
      "id": "dlg_factories",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Ertrians build from <b>Factories</b> (ground) and <b>Airports</b> (flying units). Let's train a tank.",
      "waitForContinue": true
    },
    {
      "id": "guide_factory",
      "type": "guideClick",
      "speaker": "Tutorial",
      "text": "Select your Factory.",
      "target": { "structureId": "factory" }
    },
    {
      "id": "dlg_produce_tank",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Choose a unit from the production panel. Pick a tank.",
      "waitForContinue": true
    },
    {
      "id": "dlg_air",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Airports recruit flyers that ignore terrain blocking — they are still blocked by enemy units.",
      "waitForContinue": true
    },
    {
      "id": "end_p1_prod_turn",
      "type": "endPlayerTurn",
      "player": 1,
      "waitForClick": true,
      "endTurnUiTarget": "endTurnButton"
    },
    {
      "id": "end_p2_prod_turn",
      "type": "endPlayerTurn",
      "player": 2
    },
    {
      "id": "dlg_new_units",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "New units arrive at the start of your turn. Move your tank to free the factory line.",
      "waitForContinue": true
    },
    {
      "id": "guide_tank",
      "type": "guideClick",
      "target": { "unitId": "p1_tank" }
    },
    {
      "id": "guide_move_tank",
      "type": "guideClick",
      "target": { "x": 4, "y": 4 }
    },
    {
      "id": "dlg_ranged",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Artillery can strike from distance but usually cannot move and fire the same turn.<page/>Use it to delete exposed enemies.",
      "waitForContinue": true
    },
    {
      "id": "end_p1_enemy_turn",
      "type": "endPlayerTurn",
      "player": 1
    },
    {
      "id": "p2_enemy_move",
      "type": "moveUnit",
      "unitId": "p2_enemy_tank",
      "to": { "x": 8, "y": 4 }
    },
    {
      "id": "end_p2_enemy_turn",
      "type": "endPlayerTurn",
      "player": 2
    },
    {
      "id": "dlg_artillery_range",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Your artillery can reach that tank — attack it.",
      "waitForContinue": true
    },
    {
      "id": "guide_attack",
      "type": "guideClick",
      "target": { "uiTarget": "attackButton" }
    },
    {
      "id": "guide_enemy",
      "type": "guideClick",
      "target": { "unitId": "p2_enemy_tank" }
    },
    {
      "id": "dlg_done",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Well done. You've learned the core of the <b>Ertrian</b> war machine.",
      "waitForContinue": true
    },
    {
      "id": "complete",
      "type": "showTutorialComplete"
    },
    {
      "id": "unlock",
      "type": "setInputLock",
      "locked": false
    }
  ]
}
