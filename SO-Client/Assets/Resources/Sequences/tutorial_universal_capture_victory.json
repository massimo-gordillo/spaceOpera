      "target": { "x": 8, "y": 2 }
    },
    {
      "id": "guide_capture_4",
      "type": "guideClick",
      "target": { "uiTarget": "captureButton" }
    },
    {
      "id": "dlg_finish_next_turn_4",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "End the turn — you'll finish capturing on your next turn.",
      "waitForContinue": true
    },
    {
      "id": "end_p1_capture_turn_4",
      "type": "endPlayerTurn",
      "player": 1,
      "waitForClick": true,
      "endTurnUiTarget": "endTurnButton"
    },
    {
      "id": "end_p2_capture_turn_4",
      "type": "endPlayerTurn",
      "player": 2
    },
    {
      "id": "dlg_your_turn_again_4",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Your turn again. Complete the capture.",
      "waitForContinue": true
    },
    {
      "id": "guide_infantry_5",
      "type": "guideClick",
      "target": { "unitId": "p1_infantry" }
    },
    {
      "id": "guide_capture_5",
      "type": "guideClick",
      "target": { "uiTarget": "captureButton" }
    },
    {
      "id": "dlg_victory",
      "type": "dialogue",
      "speaker": "Tutorial",
      "text": "Well done! You are victorious! Now to learn about producing units.",
